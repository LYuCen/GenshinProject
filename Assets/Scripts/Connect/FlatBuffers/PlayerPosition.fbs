namespace Connect.PositionDTO;

struct Vec3 { x:int; y:int; z:int; }

table SinglePositionFlat {
    player_id:int;
    last_processed_tick:uint;
    position:Vec3;
    
    yaw:ushort;
    pitch:ushort;
    
    move_state:ushort;
    level_speed:ushort;
    vertical_speed:short;
}

table PositionListFlat {
    players:[SinglePositionFlat];
}
