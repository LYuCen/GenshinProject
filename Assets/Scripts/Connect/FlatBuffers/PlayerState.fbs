namespace Connect.FlatDTO;

struct Vec3 {
  x:float;
  y:float;
  z:float;
}

struct Quat {
  x:float;
  y:float;
  z:float;
  w:float;
}

table PlayerDataFlat {
  player_id:int;
  position:Vec3;
  rotation:Quat;
  cur_hp:float;
  max_hp:float;
  cur_shield:float;
  max_shield:float;
}

table PlayerList {
  players:[PlayerDataFlat];
}

root_type PlayerList;
